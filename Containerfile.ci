# Stage 1: Build Telegram TDLib from source on Fedora Minimal
FROM registry.fedoraproject.org/fedora-minimal:latest AS builder

ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig:${PKG_CONFIG_PATH}
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:${LD_LIBRARY_PATH}

# Install build dependencies for TDLib
RUN microdnf -y --setopt=install_weak_deps=0 install \
    gcc-c++ \
    cmake \
    ninja-build \
    make \
    binutils \
    git \
    openssl-devel \
    zlib-ng-compat-devel \
    gperf \
    php-cli \
    && microdnf clean all

# Clone and build TDLib from upstream master
WORKDIR /tmp/tdlib
RUN git clone --depth 1 https://github.com/tdlib/td.git . \
    && mkdir build \
    && cd build \
    && cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DTD_ENABLE_LTO=OFF -G Ninja .. \
    && cmake --build . --target install \
    && cd / \
    && rm -rf /tmp/tdlib

# Stage 2: Final Minimal CI Runner Image
FROM registry.fedoraproject.org/fedora-minimal:latest

ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig:${PKG_CONFIG_PATH}
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:${LD_LIBRARY_PATH}

# Install minimal CI build, test, lint, and packaging dependencies
RUN microdnf -y --setopt=install_weak_deps=0 install \
    gcc-c++ \
    clang \
    clang-tools-extra \
    cmake \
    ninja-build \
    make \
    binutils \
    libasan \
    libubsan \
    libtsan \
    json-c-devel \
    openssl-devel \
    zlib-ng-compat-devel \
    python3-docutils \
    python3-sphinx \
    python3-sphinx_rtd_theme \
    rstcheck \
    git \
    && microdnf clean all

# Copy TDLib headers, libraries, and pkgconfig metadata from builder stage
COPY --from=builder /usr/local/include/td /usr/local/include/td
COPY --from=builder /usr/local/lib* /usr/local/

# Refresh dynamic linker cache
RUN ldconfig

WORKDIR /
